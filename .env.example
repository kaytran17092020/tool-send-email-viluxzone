# SMTP: không commit file .env thật
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sale@viluxzone.com
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM="Viluxzone" <sale@viluxzone.com>

# URL HTTPS công khai của máy chạy Nodemail, bắt buộc để click từ email ngoài Internet quay về tracker.
# Ví dụ: https://mail-tracker.your-domain.com
TRACKER_PUBLIC_URL=

# Google Analytics 4 Measurement ID đã cài trên website đích.
GA4_MEASUREMENT_ID=G-029PNZ8EV2

# File danh sách được nhập bằng nút “Dùng file nguồn đã cấu hình”.
DEFAULT_RECIPIENTS_FILE=Viluxzone_EPL_Club_Email_Segments_V3.xlsx

# Mỗi email cách ngẫu nhiên trong khoảng này. Hệ thống không cho nhỏ hơn 60 giây.
SEND_DELAY_MIN_MS=60000
SEND_DELAY_MAX_MS=120000
PORT=3030
HOST=127.0.0.1
