{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/:path((?!mail-worker$).*)", "destination": "/api/index" },
    { "source": "/r/:token", "destination": "/api/index" },
    { "source": "/event/:token", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "api/mail-worker.js": {
      "maxDuration": 60,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "nodemail-send-v2", "maxConcurrency": 1 }]
    }
  }
}

